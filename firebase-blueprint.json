{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with civic address and notification preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 256 },
        "address": { "type": "string", "maxLength": 512 },
        "state": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Vote": {
      "title": "Vote",
      "description": "Citizen vote on specific congressional bill",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "billId": { "type": "string", "maxLength": 128 },
        "vote": { "type": "string", "enum": ["yea", "nay"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "billId", "vote"]
    },
    "BaselineData": {
      "title": "BaselineData",
      "description": "Persistent baseline congressional data (bills, votes, alerts, sessions) stored as daily fallback",
      "type": "object",
      "properties": {
        "dataType": { "type": "string", "enum": ["bills", "votes", "accomplishments", "sessions", "alerts"] },
        "updatedAt": { "type": "string", "format": "date-time" },
        "backupDate": { "type": "string", "maxLength": 32 },
        "itemsCount": { "type": "number" },
        "source": { "type": "string", "maxLength": 128 },
        "data": { "type": "array" }
      },
      "required": ["dataType", "backupDate", "itemsCount"]
    },
    "DailyBackup": {
      "title": "DailyBackup",
      "description": "Snapshot of congressional baseline state taken daily to prevent stale fallbacks",
      "type": "object",
      "properties": {
        "backupId": { "type": "string", "maxLength": 64 },
        "backupDate": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "triggeredBy": { "type": "string", "maxLength": 128 },
        "billsCount": { "type": "number" },
        "votesCount": { "type": "number" },
        "status": { "type": "string", "maxLength": 32 }
      },
      "required": ["backupId", "backupDate", "billsCount", "votesCount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile and preferences"
    },
    "/votes/{voteId}": {
      "schema": "Vote",
      "description": "Stores citizen votes on congressional legislation"
    },
    "/baseline_data/{dataType}": {
      "schema": "BaselineData",
      "description": "Stores current baseline records for bills and voting to prevent stale API fallbacks"
    },
    "/daily_backups/{backupId}": {
      "schema": "DailyBackup",
      "description": "Daily backup archive keeping historical legislative snapshots"
    }
  }
}
